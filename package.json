{
  "name": "warden-discord-mcp",
  "version": "0.1.0",
  "description": "Self-hosted MCP server that gives an agent full control of a Discord server — with honest capability reporting when something is out of its power.",
  "license": "MIT",
  "author": "MASUMxFROST",
  "type": "module",
  "bin": {
    "warden-discord-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsc --watch -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "discord-bot",
    "ai-agent",
    "stdio"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "discord.js": "^14.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
