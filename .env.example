# Discord bot token — https://discord.com/developers/applications → your app → Bot → Reset Token
# NEVER commit the real token. In MCP client configs this value goes in the "env" block.
DISCORD_BOT_TOKEN=

# Optional: application/client id (derived from the token when omitted).
# DISCORD_APPLICATION_ID=

# Optional: default guild id — lets tools omit `guild_id` on single-server setups.
# WARDEN_GUILD_ID=

# Optional: ring-buffer size for captured events (default 2000).
# WARDEN_MAX_EVENTS=2000

# Optional: max concurrent watch sessions (default 20).
# WARDEN_MAX_WATCHES=20

# Optional: error | warn | info | debug (default warn). stderr only — stdout is JSON-RPC.
# WARDEN_LOG_LEVEL=warn

# Optional: when true, every mutation runs its preflight and returns would_perform
# without touching Discord (default false).
# WARDEN_DRY_RUN=false
